#!/bin/sh
# FaceUnlock postinst (v2.0.0)
#
# 1. dpkg bypasses installd, so the companion app icon will not appear until
#    uicache re-registers the app list.
# 2. Pre-create the shared data dir owned by mobile so the very first launch can
#    write templates/telemetry without any permission dance.
# 3. A reinstall means "new build, try again": clear the previous auto-disable
#    markers so v2.0.0 gets a fair chance. The tweak's own crash-loop breaker
#    will re-arm them if it really does destabilise SpringBoard.
# Never fail the install because of any of this.
if [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache 2>/dev/null || true
elif command -v uicache >/dev/null 2>&1; then
    uicache 2>/dev/null || true
fi

APPDATA=/var/jb/var/mobile/Library/FaceUnlock
mkdir -p "$APPDATA" 2>/dev/null || true
chown mobile:mobile "$APPDATA" 2>/dev/null || true
chmod 755 "$APPDATA" 2>/dev/null || true

# fresh start: drop stale state from earlier versions
rm -f "$APPDATA/DISABLED"     2>/dev/null || true
rm -f "$APPDATA/boot.plist"   2>/dev/null || true
rm -f "$APPDATA/status.plist" 2>/dev/null || true
rm -f "$APPDATA/tweak.log"    2>/dev/null || true
rm -f "$APPDATA/app.log"      2>/dev/null || true

exit 0
